<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Umbraco.Community.Handbook</PackageId>
    <Version>19.0.0-beta01</Version>
    <Authors>skttl</Authors>
    <Description>Display your own Markdown documentation inside the Umbraco backoffice.</Description>
    <PackageTags>umbraco;umbraco-marketplace;documentation;markdown;handbook</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/skttl/umbraco-handbook</PackageProjectUrl>
    <RepositoryUrl>https://github.com/skttl/umbraco-handbook</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[19.0.0-rc1,20.0.0)" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Keep Umbraco's lower-bound dependency graph on patched releases. -->
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Client/**" />
    <None Remove="Client/**" />
    <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="../../icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="THIRD_PARTY_NOTICES.md" />
    <None Include="../../appsettings-schema.Umbraco.Community.Handbook.json" Pack="true" PackagePath="" />
    <None Include="../../buildTransitive/Umbraco.Community.Handbook.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
