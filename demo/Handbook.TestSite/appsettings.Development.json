{
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Handbook.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "UnattendedUserName": "Handbook Developer",
        "UnattendedUserEmail": "admin@example.com"
      },
      "Global": {
        "UseHttps": false
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "http://localhost:5180"
      }
    }
  }
}
